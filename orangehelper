        // ================================================================
        // 天气功能（免费API，无需密钥）
        // ================================================================
        async function fetchWeather() {
            const city = '赣州';
            try {
                // 使用 wttr.in 免费天气API
                const response = await fetch(`https://wttr.in/${city}?format=%C+%t&lang=zh`, {
                    signal: AbortSignal.timeout(5000)
                });
                if (!response.ok) throw new Error('天气服务不可用');
                const text = await response.text();
                // 解析返回格式：如 "晴 +32°C"
                const match = text.match(/(.+?)\s+([+-]?\d+°C)/);
                if (match) {
                    const condition = match[1].trim();
                    const temp = match[2].trim();
                    const iconMap = {
                        '晴': '☀️',
                        '多云': '⛅',
                        '阴': '☁️',
                        '小雨': '🌦️',
                        '中雨': '🌧️',
                        '大雨': '🌧️',
                        '雷阵雨': '⛈️',
                        '雾': '🌫️',
                        '雪': '❄️'
                    };
                    let icon = '🌤️';
                    for (const [key, value] of Object.entries(iconMap)) {
                        if (condition.includes(key)) { icon = value; break; }
                    }
                    return { city: '赣州', condition, temp, icon };
                }
                return { city: '赣州', condition: '晴', temp: '32°C', icon: '☀️' };
            } catch (e) {
                console.log('天气获取失败，使用默认数据', e);
                return { city: '赣州', condition: '晴', temp: '32°C', icon: '☀️' };
            }
        }

