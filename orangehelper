                const ua = navigator.userAgent;
                let url;
                if (/android/i.test(ua)) {
                    url = `https://uri.amap.com/marker?position=&name=${encoded}&callnative=1`;
                } else if (/iphone|ipad/i.test(ua)) {
                    url = `http://maps.apple.com/?q=${encoded}`;
