            _exportData(format) {
                const data = this.data;
                let content, filename, mime;
                switch (format) {
                    case 'json':
                        content = JSON.stringify(data, null, 2);
                        filename = '橙园助手_数据备份.json';
                        mime = 'application/json';
                        break;
                    case 'csv':
                        const headers = ['日期', '类型', '分类', '金额', '重量(斤)', '客商', '地块', '备注'];
                        const rows = data.ledger.map(l => [
                            l.date || '',
                            l.type === 'income' ? '收入' : '支出',
                            l.category || l.incomeType || l.expenseType || '',
                            (l.totalPrice || l.amount || 0).toFixed(2),
                            l.weight || '',
                            l.customer || '',
                            l.plot || '通用',
                            l.note || ''
                        ]);
                        content = [headers.join(','), ...rows.map(r => r.join(','))].join('\n');
                        filename = '橙园助手_流水.csv';
                        mime = 'text/csv';
                        break;
                    case 'html':
                        const income = data.ledger.filter(l => l.type === 'income').reduce((s, l) => s + (l.totalPrice ||
                            l.amount || 0), 0);
                        const expense = data.ledger.filter(l => l.type === 'expense').reduce((s, l) => s + (l.amount || 0),
                            0);
                        content =
                            `
                            <!DOCTYPE html><html><head><meta charset="UTF-8"><title>橙园助手报告</title>
                            <style>body{font-family:system-ui;max-width:800px;margin:40px auto;padding:20px;background:#f5f7fa;}
                            h1{color:#2563EB;}table{width:100%;border-collapse:collapse;margin:16px 0;}
                            th,td{padding:6px 12px;border:1px solid #ddd;text-align:left;}
                            th{background:#f0f0f0;}.stat{display:grid;grid-template-columns:1fr 1fr 1fr 1fr;gap:12px;margin:16px 0;}
                            .stat-item{text-align:center;padding:12px;background:#fff;border-radius:8px;}
                            .stat-value{font-size:24px;font-weight:700;}.income{color:#10b981;}.expense{color:#ef4444;}.profit{color:#2563EB;}
                            </style></head><body>
                            <h1>🍊 橙园助手 · 数据报告</h1>
                            <p style="color:#64748b;">生成：${new Date().toLocaleString()}</p>
                            <div class="stat">
                                <div class="stat-item"><div>总收入</div><div class="stat-value income">¥${income.toFixed(1)}</div></div>
                                <div class="stat-item"><div>总投入</div><div class="stat-value expense">¥${expense.toFixed(1)}</div></div>
                                <div class="stat-item"><div>净利润</div><div class="stat-value profit">¥${(income-expense).toFixed(1)}</div></div>
                                <div class="stat-item"><div>总欠款</div><div class="stat-value" style="color:#ef4444;">¥${data.debts.filter(d=>d.status==='未结清').reduce((s,d)=>s+(d.debtAmount||0),0).toFixed(1)}</div></div>
                            </div>
                            <h2>📋 流水明细 (${data.ledger.length}条)</h2>
                            <table><tr><th>日期</th><th>类型</th><th>分类</th><th>金额</th><th>重量</th><th>客商</th><th>地块</th><th>备注</th></tr>
                            ${data.ledger.map(l => `<tr><td>${l.date||''}</td><td>${l.type==='income'?'💰收入':'💸支出'}</td><td>${l.category||l.incomeType||l.expenseType||''}</td><td style="color:${l.type==='income'?'#10b981':'#ef4444'}">${l.type==='income'?'+':'-'}¥${(l.totalPrice||l.amount||0).toFixed(1)}</td><td>${l.weight||''}</td><td>${l.customer||''}</td><td>${l.plot||'通用'}</td><td>${l.note||''}</td></tr>`).join('')}
                            </table>
                            <div style="text-align:center;color:#94a3b8;font-size:14px;margin-top:24px;">善春科技 · 用心做产品，让用户只需要点击</div>
                            </body></html>
                        `;
                        filename = '橙园助手_报告.html';
                        mime = 'text/html';
                        break;
                    default:
                        return;
                }
                const blob = new Blob([content], { type: mime + ';charset=utf-8' });
                const url = URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = filename;
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
                URL.revokeObjectURL(url);
                this.showToast(`✅ ${filename} 已导出`, 'success');
            }

            _importData() {
                const input = document.createElement('input');
                input.type = 'file';
                input.accept = '.json';
                input.onchange = (e) => {
                    const file = e.target.files[0];
                    if (!file) return;
                    const reader = new FileReader();
                    reader.onload = (ev) => {
                        try {
                            const data = JSON.parse(ev.target.result);
                            if (data.ledger || data.debts || data.plots) {
                                Object.assign(this.data, data);
                                this.saveData();
                                this.renderAll();
                                this.showToast('✅ 数据导入成功', 'success');
                            } else {
                                this.showToast('❌ 无效的数据格式', 'error');
                            }
                        } catch (err) {
                            this.showToast('❌ 导入失败', 'error');
                        }
                    };
                    reader.readAsText(file);
                };
                input.click();
            }

