            _showCategoryPicker(type) {
                const groups = CATEGORIES[type].groups;

                this.showModal(`选择${type === 'income' ? '收入' : '支出'}分类`, `
                    <div style="font-size:var(--font-sm);color:var(--text-muted);margin-bottom:12px;">请选择大分类</div>
                    <div class="category-group-list">
                        ${groups.map((g, idx) => `
                            <button class="cat-group-btn" data-group-idx="${idx}">
                                <span>${g.name}</span>
                                <span class="group-arrow">→</span>
                            </button>
                        `).join('')}
                    </div>
                `, [{ text: '取消', class: 'btn-ghost', action: this.closeModal }]);

                document.querySelectorAll('.cat-group-btn').forEach(el => {
                    el.addEventListener('click', () => {
                        const idx = parseInt(el.dataset.groupIdx);
                        const group = groups[idx];
                        this.closeModal();

                        this.showModal(`${group.name}`, `
                            <div style="font-size:var(--font-sm);color:var(--text-muted);margin-bottom:12px;">请选择具体分类</div>
                            <div class="category-item-list">
                                ${group.items.map(item => `
                                    <button class="cat-item-btn" data-item="${item}" data-group="${group.name}">${item}</button>
                                `).join('')}
                            </div>
                        `, [
                            { text: '返回', class: 'btn-ghost', action: () => {
                                    this.closeModal();
                                    setTimeout(() => this._showCategoryPicker(type), 200);
                                } },
                            { text: '取消', class: 'btn-ghost', action: this.closeModal }
                        ]);

                        document.querySelectorAll('.cat-item-btn').forEach(btn => {
                            btn.addEventListener('click', () => {
                                const item = btn.dataset.item;
                                const groupName = btn.dataset.group;
                                this.selectedCategory = { type, group: groupName, item };
                                this.closeModal();
                                this.renderRecord();
                                this.showToast(`已选择：${groupName} · ${item}`, 'success');
                            });
                        });
                    });
                });
            }

            _saveRecord(type) {
                const isIncome = type === 'income';
                const date = document.getElementById('recordDate').value;
                if (!date) { this.showToast('请选择日期', 'error'); return; }
                const plot = document.getElementById('recordPlot').value || '通用地块';
                const note = document.getElementById('recordNote').value || '';

                const sel = this.selectedCategory;
                let category = sel.item || (isIncome ? '鲜果销售' : '化肥');
                if (sel.group) category = sel.group + '·' + category;

                if (isIncome) {
                    const weight = parseFloat(document.getElementById('incomeWeight').value) || 0;
                    const unitPrice = parseFloat(document.getElementById('incomeUnitPrice').value) || 0;
                    const totalPrice = weight * unitPrice;
                    const payStatus = document.getElementById('incomePayStatus').value;
                    const customer = document.getElementById('incomeCustomer').value || '';
                    const paid = parseFloat(document.getElementById('incomePaid').value) || 0;

                    if (weight <= 0 || unitPrice <= 0) { this.showToast('请输入重量和单价', 'error'); return; }
                    if (payStatus === '赊账' && !customer) { this.showToast('赊账请填写客商名称', 'error'); return; }

                    const record = {
                        id: 'L' + Date.now(),
                        type: 'income',
                        incomeType: category,
                        category: category,
                        weight,
                        unitPrice,
                        totalPrice,
                        payStatus,
                        customer,
                        paid,
                        debt: totalPrice - paid,
                        date,
                        season: this.currentSeason,
                        plot,
                        note,
                        createdAt: Date.now()
                    };
                    this.data.ledger.push(record);

                    if (payStatus === '赊账' && customer) {
                        const debt = {
                            id: 'D' + Date.now(),
                            customer,
                            recordId: record.id,
                            date,
                            totalPrice,
                            paid,
                            debtAmount: totalPrice - paid,
                            status: '未结清',
                            season: this.currentSeason,
                            note: note || category,
                            createdAt: Date.now()
                        };
                        this.data.debts.push(debt);
                    }

                    this.saveData();
                    this.renderAll();
                    this.showToast('✅ 收入已保存', 'success');

                } else {
                    const amount = parseFloat(document.getElementById('expenseAmount').value) || 0;
                    const materialQty = document.getElementById('expenseMaterialQty').value || '';

                    if (amount <= 0) { this.showToast('请输入支出金额', 'error'); return; }

                    const record = {
                        id: 'L' + Date.now(),
                        type: 'expense',
                        expenseType: category,
                        category: category,
                        amount,
                        materialQty,
                        date,
                        season: this.currentSeason,
                        plot,
                        note,
                        createdAt: Date.now()
                    };
                    this.data.ledger.push(record);
                    this.saveData();
                    this.renderAll();
                    this.showToast('✅ 支出已保存', 'success');
                }

                this.renderRecord();
            }

            setRecordTab(type) {
                this.recordTab = type;
                this.selectedCategory = { type, group: '', item: '' };
                this.renderRecord();
            }

