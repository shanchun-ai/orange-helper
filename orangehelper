            openApp(scheme, fallback) {
                const iframe = document.createElement('iframe');
                iframe.style.display = 'none';
                iframe.src = scheme;
                document.body.appendChild(iframe);
                setTimeout(() => { document.body.removeChild(iframe); if (fallback) window.open(fallback); }, 1500);
            },
            share(title, text, url) {
                if (navigator.share) { navigator.share({ title, text, url }).catch(() => {}); return; }
                const full = `${title||''}\n${text||''}\n${url||''}`.trim();
                if (navigator.clipboard) { navigator.clipboard.writeText(full).then(() => { if (window.app) window.app
                            .showToast('📋 已复制', 'success'); }); } else { this._fallbackCopy(full); }
            },
            _fallbackCopy(text) {
                const ta = document.createElement('textarea');
                ta.value = text;
                ta.style.cssText = 'position:fixed;left:-9999px;top:-9999px;';
                document.body.appendChild(ta);
                ta.select();
                try { document.execCommand('copy'); if (window.app) window.app.showToast('📋 已复制', 'success'); } catch (
                e) {}
                document.body.removeChild(ta);
