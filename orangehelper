                                    <label>已收金额 <span class="sub-label">(元)</span></label>
                                    <input class="form-control" type="number" id="incomePaid" placeholder="0" step="0.01" min="0">
                                </div>
                            ` : `
                                <div class="form-group">
                                    <label>支出金额 <span class="sub-label">(元)</span></label>
                                    <input class="form-control" type="number" id="expenseAmount" placeholder="0" step="0.01" min="0">
                                </div>
                                <div class="form-group">
