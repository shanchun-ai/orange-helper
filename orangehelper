            initMarquee() {
                const items = this.getMarqueeItems();
                if (items.length < 3) return;
                this.marqueeItems = items;
                this.marqueeTotal = items.length;

                // 复制两份实现无缝循环（3份保证无缝）
                const displayItems = [...items, ...items, ...items];
                const track = document.getElementById('marqueeTrack');
                if (!track) return;

                // 清空并填充
                track.innerHTML = '';
                displayItems.forEach(item => {
                    const div = document.createElement('div');
                    div.className = 'marquee-item';
                    div.innerHTML = `
                        <div class="m-name">${item.name}</div>
                        <div style="display:flex;justify-content:center;gap:4px;font-size:9px;color:var(--text-muted);">
                            <span>${item.tag}</span>
                            <span>${item.region}</span>
                        </div>
                    `;
                    div.addEventListener('click', () => this.openMarqueeItem(item.type, item.id));
                    track.appendChild(div);
                });

                const itemWidth = 100 / 3;
                const totalWidth = displayItems.length * itemWidth;
                const startIndex = this.marqueeTotal;
                track.style.transform = `translateX(-${startIndex * itemWidth}%)`;

                // 初始化dots
                const dotsContainer = document.querySelector('.marquee-dots');
                if (dotsContainer) {
                    dotsContainer.innerHTML = items.map((_, i) =>
                        `<span class="dot ${i === 0 ? 'active' : ''}"></span>`
                    ).join('');
                }

                // 自动轮播
                let currentIndex = this.marqueeTotal;
                let autoPlayInterval = null;

                const startAutoPlay = () => {
                    if (autoPlayInterval) clearInterval(autoPlayInterval);
                    autoPlayInterval = setInterval(() => {
                        if (this.isDragging) return;
                        currentIndex++;
                        const maxIndex = this.marqueeTotal * 2;
                        if (currentIndex >= maxIndex) {
                            // 无缝跳转到中间份的对应位置
                            currentIndex = this.marqueeTotal;
                            track.style.transition = 'none';
                            track.style.transform = `translateX(-${currentIndex * itemWidth}%)`;
                            void track.offsetHeight;
                            track.style.transition = 'transform 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94)';
                            currentIndex++;
                        }
                        track.style.transform = `translateX(-${currentIndex * itemWidth}%)`;
                        const dotIndex = ((currentIndex - this.marqueeTotal) % this.marqueeTotal + this.marqueeTotal) %
                            this.marqueeTotal;
                        this.updateMarqueeDots(dotIndex);
                    }, 3000);
                };

                // 手动滑动支持
                let startX = 0;
                let isDragging = false;
                let startTransform = 0;

                track.addEventListener('mousedown', (e) => {
                    isDragging = true;
                    this.isDragging = true;
                    startX = e.clientX;
                    const computedStyle = window.getComputedStyle(track);
                    const matrix = computedStyle.transform;
                    if (matrix !== 'none') {
                        const values = matrix.match(/matrix.*\((.+)\)/);
                        if (values) {
                            const vals = values[1].split(', ');
                            startTransform = parseFloat(vals[4]) || 0;
                        }
                    }
                    track.style.transition = 'none';
                    if (autoPlayInterval) clearInterval(autoPlayInterval);
                });

                track.addEventListener('touchstart', (e) => {
                    isDragging = true;
                    this.isDragging = true;
                    startX = e.touches[0].clientX;
                    const computedStyle = window.getComputedStyle(track);
                    const matrix = computedStyle.transform;
                    if (matrix !== 'none') {
                        const values = matrix.match(/matrix.*\((.+)\)/);
                        if (values) {
                            const vals = values[1].split(', ');
                            startTransform = parseFloat(vals[4]) || 0;
                        }
                    }
                    track.style.transition = 'none';
                    if (autoPlayInterval) clearInterval(autoPlayInterval);
                });

                const moveHandler = (e) => {
                    if (!isDragging) return;
                    const clientX = e.clientX || (e.touches && e.touches[0].clientX);
                    if (!clientX) return;
                    const deltaX = (clientX - startX) / track.offsetWidth * 100;
                    const newTransform = startTransform + deltaX;
                    track.style.transform = `translateX(${newTransform}%)`;
                };

                track.addEventListener('mousemove', moveHandler);
                track.addEventListener('touchmove', moveHandler, { passive: false });

                const endHandler = () => {
                    if (!isDragging) return;
                    isDragging = false;
                    this.isDragging = false;
                    const computedStyle = window.getComputedStyle(track);
                    const matrix = computedStyle.transform;
                    let currentTransform = 0;
                    if (matrix !== 'none') {
                        const values = matrix.match(/matrix.*\((.+)\)/);
                        if (values) {
                            const vals = values[1].split(', ');
                            currentTransform = parseFloat(vals[4]) || 0;
                        }
                    }
                    track.style.transition = 'transform 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94)';
                    const itemWidthPercent = 100 / 3;
                    const nearestIndex = Math.round(-currentTransform / itemWidthPercent);
                    const clampedIndex = Math.max(this.marqueeTotal, Math.min(this.marqueeTotal * 2, nearestIndex));
                    track.style.transform = `translateX(-${clampedIndex * itemWidthPercent}%)`;
                    const dotIndex = ((clampedIndex - this.marqueeTotal) % this.marqueeTotal + this.marqueeTotal) %
                        this.marqueeTotal;
                    this.updateMarqueeDots(dotIndex);
                    currentIndex = clampedIndex;
                    startAutoPlay();
                };

                track.addEventListener('mouseup', endHandler);
                track.addEventListener('mouseleave', endHandler);
                track.addEventListener('touchend', endHandler);
                track.addEventListener('touchcancel', endHandler);

                startAutoPlay();
                this.marqueeTimer = autoPlayInterval;
            }

