            // ================================================================
            // 导航
            // ================================================================
            setupNavigation() {
                const pages = document.getElementById('pageContainer');
                const items = document.querySelectorAll('.bottom-nav .nav-item');

                items.forEach(item => {
                    item.addEventListener('click', () => {
                        const idx = parseInt(item.dataset.index);
                        if (!isNaN(idx)) this.switchPage(idx);
                    });
                });

                let timeout;
                pages.addEventListener('scroll', () => {
                    clearTimeout(timeout);
                    timeout = setTimeout(() => {
                        const idx = Math.round(pages.scrollLeft / pages.clientWidth);
                        this.updateNav(idx);
                    }, 50);
                });
                pages.addEventListener('scrollend', () => {
                    const idx = Math.round(pages.scrollLeft / pages.clientWidth);
                    this.updateNav(idx);
                });
                this.updateNav(0);
            }

            switchPage(index) {
                const pages = document.getElementById('pageContainer');
                const max = pages.children.length - 1;
                const target = Math.max(0, Math.min(index, max));
                pages.scrollTo({ left: target * pages.clientWidth, behavior: 'smooth' });
                this.updateNav(target);
            }

            updateNav(index) {
                const items = document.querySelectorAll('.bottom-nav .nav-item');
                items.forEach((item, i) => {
                    item.classList.toggle('active', i === index);
                });
                this.currentPage = index;
            }

