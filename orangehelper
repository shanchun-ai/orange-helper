            setupCompliance() {
                const overlay = document.getElementById('complianceOverlay');
                const check = document.getElementById('complianceCheck');
                const agree = document.getElementById('complianceAgree');
                const exit = document.getElementById('complianceExit');

                if (localStorage.getItem('shanchun_agreed') === 'true') {
                    overlay.classList.add('hidden');
                    return;
                }

                check.addEventListener('change', () => { agree.disabled = !check.checked; });
                agree.addEventListener('click', () => {
                    if (!check.checked) return;
                    localStorage.setItem('shanchun_agreed', 'true');
                    overlay.classList.add('hidden');
                });
                exit.addEventListener('click', () => {
                    if (confirm('您确定要退出吗？需要同意协议才能使用本应用。')) window.close();
                });

                document.getElementById('privacyLink').addEventListener('click', (e) => {
                    e.preventDefault();
