                const iframe = document.createElement('iframe');
                iframe.style.display = 'none';
                iframe.src = scheme;
                document.body.appendChild(iframe);
                const t = setTimeout(() => { document.body.removeChild(iframe); if (cb) cb(false); }, 1500);
                iframe.onload = () => { clearTimeout(t);
                    document.body.removeChild(iframe); if (cb) cb(true); };
            },
