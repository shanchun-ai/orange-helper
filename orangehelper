                                    <input class="form-control" type="text" id="incomeTotalPrice" readonly placeholder="0.00">
                                </div>
                                <div class="form-group">
                                    <label>收款状态</label>
                                    <select class="form-control" id="incomePayStatus">
                                        <option value="已结清">✅ 已结清</option>
