                        const w = parseFloat(weightEl.value) || 0;
                        const p = parseFloat(priceEl.value) || 0;
                        totalEl.value = (w * p).toFixed(2);
                    };
                    weightEl.addEventListener('input', calcTotal);
                    priceEl.addEventListener('input', calcTotal);

                    const payStatusEl = document.getElementById('incomePayStatus');
                    const customerField = document.getElementById('incomeCustomerField');
                    const paidField = document.getElementById('incomePaidField');
                    payStatusEl.addEventListener('change', function() {
                        const isDebt = this.value === '赊账';
                        customerField.style.display = isDebt ? 'block' : 'none';
